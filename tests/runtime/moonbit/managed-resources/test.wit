package test:managed-resources;

interface api {
  resource counter {
    constructor(value: u32);
    get: func() -> u32;
    add: func(delta: u32);
  }

  resource checked-counter {
    constructor(value: u32) -> result<checked-counter, string>;
    get: func() -> u32;
  }
  checked-drop-count: func() -> u32;

  record borrowed {
    value: borrow<counter>,
  }

  read: func(value: borrow<counter>) -> u32;
  read-record: func(value: borrowed) -> u32;
  bounce: func(value: counter) -> counter;
  consume: func(value: counter);
  drop-saved-alias: func();
  drop-count: func() -> u32;
}

world test {
  export api;
}

world runner {
  import api;
  export run: func();
}
